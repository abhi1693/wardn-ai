{
  "name": "@wardn/web",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "api:generate": "orval --config ./orval.config.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "e2e:prepare": "mkdir -p .next/standalone/wardn/frontend/.next && rm -rf .next/standalone/wardn/frontend/.next/static .next/standalone/wardn/frontend/public && cp -R .next/static .next/standalone/wardn/frontend/.next/static && cp -R public .next/standalone/wardn/frontend/public",
    "e2e": "NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:${WARDN_E2E_BACKEND_PORT:-4100} npm run build && npm run e2e:prepare && playwright test",
    "e2e:update": "NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:${WARDN_E2E_BACKEND_PORT:-4100} npm run build && npm run e2e:prepare && playwright test --update-snapshots"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.211",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.3.0",
    "ai": "^6.0.209",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "^16.2.12",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@next/eslint-plugin-next": "16.2.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.12",
    "eslint-import-resolver-node": "^0.3.6",
    "eslint-import-resolver-typescript": "^3.5.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "16.4.0",
    "orval": "^8.24.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.46.0",
    "typescript": "^5.6.0"
  }
