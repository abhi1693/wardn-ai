{
  "name": "@wardn/web",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "api:generate": "orval --config ./orval.config.mjs",
    "dev": "next dev",
    "build": "next build",
    "bundle:analyze": "next build --experimental-analyze",
    "bundle:check": "node scripts/check-bundle-budgets.mjs",
    "bundle:validate": "npm run bundle:analyze && npm run bundle:check",
    "start": "next start",
    "lint": "eslint .",
    "e2e:prepare": "mkdir -p .next/standalone/wardn/frontend/.next && rm -rf .next/standalone/wardn/frontend/.next/static .next/standalone/wardn/frontend/public && cp -R .next/static .next/standalone/wardn/frontend/.next/static && cp -R public .next/standalone/wardn/frontend/public",
    "test:browser": "npm run test:components && npm run e2e",
    "test:components": "cypress run --component --browser electron",
    "e2e": "node cypress/run-e2e.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.154",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^9.3.1",
    "ai": "^7.0.150",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/cypress": "^10.1.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "cypress-visual-regression": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.13.0",
    "orval": "^8.44.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
