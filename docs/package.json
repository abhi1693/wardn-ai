{
  "name": "@wardn-ai/docs",
  "private": true,
  "scripts": {
    "build": "antora --stacktrace --log-format=pretty --log-level=info playbook-local.yml",
    "clean": "rm -rf build tmp",
    "preview": "http-server build/site -c-1 -p 8081",
    "sync:openapi": "mkdir -p site/latest/modules/ROOT/attachments/openapi && cp ../wardn/frontend/openapi/wardn-api.json site/latest/modules/ROOT/attachments/openapi/wardn-api.json",
    "validate": "npm run build",
    "test:dependency-security": "node --test tests/braces.test.cjs"
  },
  "devDependencies": {
    "@antora/lunr-extension": "1.0.0-alpha.13",
    "@asciidoctor/tabs": "1.0.0-beta.6",
    "antora": "3.2.1",
    "http-server": "14.1.1",
    "braces": "file:packages/braces"
  },
  "overrides": {
    "braces": "$braces"
  }
}
