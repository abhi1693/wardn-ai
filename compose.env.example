# Copy to .env at the repository root. Never commit that file.
# Generate THREE different values with: openssl rand -hex 32
# Hex keeps the PostgreSQL password safe to interpolate into a database URL.
POSTGRES_PASSWORD=
WARDN_API_TOKEN_SECRET=
WARDN_SESSION_SECRET=

# Published master images support Linux AMD64 and ARM64. Pin matching image
# versions or commit SHAs for repeatable upgrades; full digest references work too.
# WARDN_WORKER_IMAGE=ghcr.io/abhi1693/wardn-ai-worker:master
# WARDN_FRONTEND_IMAGE=ghcr.io/abhi1693/wardn-ai-frontend:master

WARDN_BIND_IP=0.0.0.0
WARDN_PORT=3000
# Set this to the browser-visible origin for LAN access or a TLS reverse proxy.
# When omitted, it follows WARDN_PORT: http://localhost:3000 by default.
# WARDN_PUBLIC_BASE_URL=https://wardn.example.com

# Local mode enables trusted npm/Python MCP packages inside the API/worker.
# For remote HTTP MCP servers only, use production + remote instead.
WARDN_ENVIRONMENT=local
WARDN_MCP_RUNTIME_PROVIDER=local
WARDN_TELEMETRY=true
WARDN_LOG_LEVEL=INFO
WARDN_LOG_FORMAT=text
WARDN_JOB_LOGS_ENABLED=true
WARDN_JOB_LOG_MAX_ENTRIES=1000
WARDN_JOB_LOG_TTL_SECONDS=604800

# Bundled OpenBao UI/API is published on loopback only.
WARDN_OPENBAO_PORT=8200
# Run scripts/compose/setup_openbao.py after starting OpenBao to provision AppRole files.
WARDN_OPENBAO_AUTH_PROFILES_JSON={"compose":{"baseUrl":"http://openbao:8200","method":"approle","roleIdFile":"role_id","secretIdFile":"secret_id","tlsVerify":false}}

# Local authentication is the default. No default account/password is created.
# WARDN_AUTH_MODE=oidc
# WARDN_OIDC_PROVIDER_NAME=Company login
# WARDN_OIDC_ISSUER_URL=https://identity.example.com
# WARDN_OIDC_CLIENT_ID=
# WARDN_OIDC_CLIENT_SECRET=
# WARDN_OIDC_REDIRECT_URI=https://wardn.example.com/api/auth/oidc/callback
# WARDN_OIDC_SCOPES=openid email profile
# WARDN_OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# WARDN_OIDC_SUPERUSER_EMAILS=admin@example.com

# Optional backend settings; these are never injected into the frontend.
# WARDN_GITHUB_TOKEN=
# WARDN_MCP_TOOL_PROPOSAL_ENABLED=false
# WARDN_MCP_TOOL_PROPOSAL_API_TOKEN=
# WARDN_OUTBOUND_HTTP_ALLOW_HTTP=true
# WARDN_OUTBOUND_HTTP_ALLOWED_PORTS=443,8200,8000
# WARDN_OUTBOUND_HTTP_PRIVATE_HOST_ALLOWLIST=openbao,host.docker.internal
# WARDN_CHAT_PROVIDER_WHATSAPP_BRIDGE_BASE_URL=http://host.docker.internal:8082
